    "updates.unavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates Not Set Up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置更新"
          }
        }
      }
    },
    "updates.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This private build does not publish in-app updates yet. Install a newer build from your usual channel when available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前私有构建尚未发布应用内更新。有新版本时请按平时的安装方式覆盖安装。"
          }
        }
      }
    },
    "updates.unavailable.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "panel.darkMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式"
          }
        }
      }
    },
    "panel.automationNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow HandySwitch when macOS asks to control System Events. If it is missing from Automation, toggle Dark Mode again after updating—the entry appears only after that prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统弹窗里允许 HandySwitch 控制「系统事件」。若自动化列表里没有它：更新后再拨一次深色模式——列表只会在弹过授权窗之后才出现该项。"
          }
        }
      }
    },
    "panel.openAutomation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HandySwitch needs to control System Events to switch Dark Mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HandySwitch 需要控制「系统事件」以切换深色模式。"
          }
        }
      }
    },
