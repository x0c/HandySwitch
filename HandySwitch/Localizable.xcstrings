    "settings.launchAtLogin.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Requires your approval in Login Items when first enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。首次开启时需在登录项中批准。"
          }
        }
      }
    },
    "settings.launchAtLogin.needsApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval in System Settings › General › Login Items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待在「系统设置 › 通用 › 登录项」中批准。"
          }
        }
      }
    },
    "settings.launchAtLogin.openLoginItems": {
